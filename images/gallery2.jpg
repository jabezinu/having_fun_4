<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <rect width="100%" height="100%" fill="#A67C52"/>
  <text x="50%" y="50%" font-family="Arial" font-size="24" fill="#fff" text-anchor="middle" dominant-baseline="middle">Coffee Shop Interior</text>
  <rect x="100" y="100" width="400" height="200" fill="#8B5A2B" opacity="0.7"/>
  <circle cx="200" cy="150" r="20" fill="#D4AF37" opacity="0.8"/>
  <circle cx="400" cy="150" r="20" fill="#D4AF37" opacity="0.8"/>
