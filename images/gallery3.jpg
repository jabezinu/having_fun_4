<svg xmlns="http://www.w3.org/2000/svg" width="600" height="400" viewBox="0 0 600 400">
  <rect width="100%" height="100%" fill="#C49A6C"/>
  <text x="50%" y="50%" font-family="Arial" font-size="24" fill="#fff" text-anchor="middle" dominant-baseline="middle">Coffee Beans</text>
  <ellipse cx="250" cy="200" rx="40" ry="60" fill="#8B5A2B" opacity="0.8"/>
  <ellipse cx="350" cy="200" rx="40" ry="60" fill="#8B5A2B" opacity="0.8"/>
  <ellipse cx="300" cy="300" rx="40" ry="60" fill="#8B5A2B" opacity="0.8" transform="rotate(-30,300,300)"/>
  <ellipse cx="200" cy="300" rx="40" ry="60" fill="#8B5A2B" opacity="0.8" transform="rotate(30,200,300)"/>
  <ellipse cx="400" cy="300" rx="40" ry="60" fill="#8B5A2B" opacity="0.8" transform="rotate(-60,400,300)"/>
